# Port to listen on (Railway sets this automatically)
PORT=3001

# Secret required in x-api-secret header on every request
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=your-secret-here

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://riseq.eu,https://www.riseq.eu,https://winddown-eosin.vercel.app,http://localhost:5173
