# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your-resend-api-key

# Internal API security
# The server checks this token on every /api/companies request.
# The same value must be set as VITE_INTERNAL_API_TOKEN so the frontend can send it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=your-secret-token-here
VITE_INTERNAL_API_TOKEN=your-secret-token-here
