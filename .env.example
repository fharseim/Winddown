# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your-resend-api-key

# Internal API security
# The server checks this token on every /api/companies request.
# The same value must be set as VITE_INTERNAL_API_TOKEN so the frontend can send it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=your-secret-token-here
VITE_INTERNAL_API_TOKEN=your-secret-token-here

# HR Crawler (Railway)
# Set CRAWLER_URL to the public Railway URL of the hr-crawler service.
# When set, the Vercel API routes proxy HR requests to Railway instead of
# attempting a direct connection to handelsregister.de.
# Leave empty to fall back to direct/dataset mode (local dev).
CRAWLER_URL=https://your-service.up.railway.app
# The API_SECRET configured on the Railway crawler service
CRAWLER_SECRET=your-crawler-secret-here
